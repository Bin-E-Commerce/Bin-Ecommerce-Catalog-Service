# Copy file này thành `.env` khi chạy Catalog Service local.
# Không commit `.env` hoặc password PostgreSQL lên Git.
#
# Quy tắc theo môi trường:
# - Chạy trực tiếp trên máy: dùng localhost và port expose của PostgreSQL.
# - Docker Compose/Kubernetes: đổi localhost thành tên service/DNS nội bộ.
# - Production: inject secret từ Secret Manager/Kubernetes Secret.

# ============================================================================
# 01 · Runtime và HTTP API
# Catalog Service sở hữu category, attribute và option dùng chung toàn hệ thống.
# ============================================================================

APP_VERSION=1.0.0                                      # Version hiển thị trong health response
NODE_ENV=development                                   # development | test | production
PORT=3003                                              # Port local và port nội bộ của container

# ============================================================================
# 02 · PostgreSQL - nguồn dữ liệu của Catalog Service
# ============================================================================

POSTGRES_HOST=localhost                                # Docker/K8s: postgres hoặc DNS PostgreSQL managed
POSTGRES_PORT=5432                                     # Cổng PostgreSQL
POSTGRES_USER=bin_ecommerce                             # User kết nối database
POSTGRES_PASSWORD=
POSTGRES_DB=bin_ecommerce_catalog                       # Database riêng của Catalog Service

# ============================================================================
# 03 · Log và vận hành database
# Catalog đang dùng synchronize ở development; production cần schema được quản lý
# bằng migration hoặc quy trình khởi tạo database riêng trước khi rollout.
# ============================================================================

TYPEORM_LOGGING=false                                   # true chỉ nên dùng khi cần điều tra SQL local
